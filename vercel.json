{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/hotelier",
      "destination": "/teakhouse",
      "permanent": true
    },
    {
      "source": "/hotelier.html",
      "destination": "/teakhouse",
      "permanent": true
    },
    {
      "source": "/work/praow",
      "destination": "/praow",
      "permanent": true
    },
    {
      "source": "/work/praow.html",
      "destination": "/praow",
      "permanent": true
    },
    {
      "source": "/th/work/praow",
      "destination": "/th/praow",
      "permanent": true
    },
    {
      "source": "/th/work/praow.html",
      "destination": "/th/praow",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/review",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/review/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
